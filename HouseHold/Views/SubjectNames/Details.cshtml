@model HouseHold.Models.SubjectName

@{
    ViewData["Title"] = "科目の詳細";
}


    <div>
        <h4>科目</h4>
        <hr />
        <dl class="row">
            <dt class = "col-sm-2">
                科目名
            </dt>
            <dd class = "col-sm-10">
                @Html.DisplayFor(model => model.CourseName)
            </dd>
            <dt class = "col-sm-2">
                科目ID
            </dt>
            <dd class = "col-sm-10">
                @Html.DisplayFor(model => model.SubjectNameId)
            </dd>
            <dt class = "col-sm-2">
                画像URL
            </dt>
            <dd class = "col-sm-10">
                @Html.DisplayFor(model => model.ImageUrl)
            </dd>
        </dl>
    </div>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.SubjectNameId" class="btn btn-primary">編集</a>
        <a asp-action="Index" class="btn btn-secondary">一覧に戻る</a>
    </div>
