@model HouseHold.Models.SubjectName

@{
    ViewData["Title"] = "科目の削除";
}


    <h3>以下の項目を削除してもよろしいですか。</h3>
    <div>
        <h4>科目</h4>
        <hr />
        <dl class="row">
            <dt class = "col-sm-2">
                科目名
            </dt>
            <dd class = "col-sm-10">
                @Html.DisplayFor(model => model.CourseName)
            </dd>
        </dl>
    </div>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="SubjectNameId" />
        <input type="submit" value="削除" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">キャンセル</a>
    </form>
