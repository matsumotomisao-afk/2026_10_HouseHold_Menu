@model HouseHold.Models.PaymentType

@{
    ViewData["Title"] = "支払区分の詳細";
}


    <div>
        <h4>支払区分</h4>
        <hr />
        <dl class="row">
            <dt class = "col-sm-2">
                支払区分
            </dt>
            <dd class = "col-sm-10">
                @Html.DisplayFor(model => model.TypeName)
            </dd>
            <dt class = "col-sm-2">
                支払区分ID
            </dt>
            <dd class = "col-sm-10">
                @Html.DisplayFor(model => model.PaymentTypeId)
            </dd>
        </dl>
    </div>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.PaymentTypeId" class="btn btn-primary">編集</a>
        <a asp-action="Index" class="btn btn-secondary">一覧に戻る</a>
    </div>
