@model HouseHold.Models.Payment

@{
    ViewData["Title"] = "支払の削除";
}

<h3>本当に削除しますか？</h3>
<div>
    <h4>支払</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">支払日</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.Posted)</dd>

        <dt class = "col-sm-2">品目</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.ItemName)</dd>

        <dt class = "col-sm-2">支払先</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.PaymentName)</dd>

        <dt class = "col-sm-2">金額</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.Amount)</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="PaymentId" />
        <input type="submit" value="削除" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">キャンセル</a>
    </form>
</div>
