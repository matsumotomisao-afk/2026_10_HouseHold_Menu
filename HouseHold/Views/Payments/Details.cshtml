@model HouseHold.Models.Payment

@{
    ViewData["Title"] = "支払の詳細";
}

<div>
    <h4>支払</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">支払日</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.Posted)</dd>

        <dt class = "col-sm-2">収支</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.InOut)</dd>

        <dt class = "col-sm-2">科目</dt>
        <dd class = "col-sm-10">@Model.SubjectNameNavigation?.CourseName</dd>

        <dt class = "col-sm-2">品目</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.ItemName)</dd>

        <dt class = "col-sm-2">支払先</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.PaymentName)</dd>

        <dt class = "col-sm-2">支払区分</dt>
        <dd class = "col-sm-10">@Model.PaymentTypeNavigation?.TypeName</dd>

        <dt class = "col-sm-2">支払方法</dt>
        <dd class = "col-sm-10">@Model.PaymentMethodNavigation?.MethodName</dd>

        <dt class = "col-sm-2">金額</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.Amount)</dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.PaymentId" class="btn btn-primary">編集</a>
    <a asp-action="Index" class="btn btn-secondary">一覧に戻る</a>
</div>
