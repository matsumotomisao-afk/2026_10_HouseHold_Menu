@model IEnumerable<HouseHold.Models.PaymentMethod>

@{
    ViewData["Title"] = "支払方法一覧";
}


    <a asp-action="Create" class="btn btn-primary">新規作成</a>
</p>

    <thead>
        <tr>
            <th>支払いの詳細</th>
            <th>支払区分</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
    <tr>
        <td>@Html.DisplayFor(modelItem => item.MethodName)</td>
        <td>@(item.PaymentType != null ? item.PaymentType.TypeName : string.Empty)</td>
        <td>
            <a asp-action="Details" asp-route-id="@item.PaymentMethodId">詳細</a> |
            <a asp-action="Edit" asp-route-id="@item.PaymentMethodId">編集</a> |
            <a asp-action="Delete" asp-route-id="@item.PaymentMethodId">削除</a>
        </td>
    </tr>
}
    </tbody>
</table>
