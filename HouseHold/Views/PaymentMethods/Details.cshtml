@model HouseHold.Models.PaymentMethod

@{
    ViewData["Title"] = "支払方法の詳細";
}

    <dl class="row">
        <dt class = "col-sm-2">
            支払いの詳細
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.MethodName)
        </dd>
        <dt class = "col-sm-2">
            支払区分
        </dt>
        <dd class = "col-sm-10">
            @(Model.PaymentType != null ? Model.PaymentType.TypeName : string.Empty)
        </dd>
    </dl>

    <a asp-action="Edit" asp-route-id="@Model.PaymentMethodId" class="btn btn-primary">編集</a>
    <a asp-action="Index" class="btn btn-secondary">一覧に戻る</a>
