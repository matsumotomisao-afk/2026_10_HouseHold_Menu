@model HouseHold.Models.IncomeType

@{
    ViewData["Title"] = "所得の種類の詳細";
}


    <h4>IncomeType</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">所得の種類</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.TypeName)</dd>
        <dt class="col-sm-2">所得区分ID</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.IncomeCategoryId)</dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.IncomeTypeId" class="btn btn-primary">編集</a>
    <a asp-action="Index" class="btn btn-secondary">一覧に戻る</a>
</div>
