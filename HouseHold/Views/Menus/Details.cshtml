@model HouseHold.Models.Menu

@{
    ViewData["Title"] = "メニュー詳細";
}


    <div>
        <h4>メニュー</h4>
        <hr />
        <dl class="row">
            <dt class="col-sm-2">タイトル</dt>
            <dd class="col-sm-10">@Model.Title</dd>

            <dt class="col-sm-2">URL</dt>
            <dd class="col-sm-10">@Model.Url</dd>

            <dt class="col-sm-2">スラッグ</dt>
            <dd class="col-sm-10">@Model.Slug</dd>

            <dt class="col-sm-2">親メニュー</dt>
            <dd class="col-sm-10">@Model.Parent?.Title</dd>

            <dt class="col-sm-2">表示順</dt>
            <dd class="col-sm-10">@Model.SortOrder</dd>

            <dt class="col-sm-2">表示</dt>
            <dd class="col-sm-10">@Model.IsVisibleInMenu</dd>
        </dl>
    </div>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">編集</a>
        <a asp-action="Index" class="btn btn-secondary">一覧に戻る</a>
    </div>
